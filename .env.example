# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Google OAuth — create Desktop client IDs at console.cloud.google.com
# Download JSON and save as credentials.json (personal) and credentials_school.json (school)

# Supabase — for the auth gate on the production deployment (optional)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
